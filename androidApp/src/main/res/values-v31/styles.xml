<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Compatibility attributes for androidx.core:core-splashscreen -->
        <item name="windowSplashScreenBackground">#090710</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>

        <!-- Platform attributes for Android 12+ (API 31+) framework -->
        <item name="android:windowSplashScreenBackground">#090710</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>